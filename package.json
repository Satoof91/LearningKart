{
  "name": "learningkart",
  "version": "1.0.0",
  "description": "LearningKart - kids kart racer (Capacitor, Android + iOS)",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "node build.js",
    "sync": "node build.js && cap sync",
    "android": "node build.js && cap sync android && cap open android",
    "android:apk": "node build.js && cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "node build.js && cap sync ios && cap open ios",
    "assets": "capacitor-assets generate --android --ios",
    "test": "node build.js && node test/game.js",
    "voice": "esbuild tools/make-voice.js --bundle --platform=node --format=cjs --log-level=warning --outfile=tools/.make-voice.cjs && node tools/.make-voice.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/native-purchases": "^8.9.6",
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  },
  "private": true
}
